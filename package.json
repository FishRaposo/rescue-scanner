{
  "name": "rescue-scanner",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev frontend",
    "build": "next build frontend",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "unit": "vitest run",
    "e2e": "playwright test",
    "scan": "node scanner/bin.mjs scan",
    "scan:fixtures": "node scanner/bin.mjs scan fixtures/bad-app --format json --out fixtures/scans/bad-app.scan.json --fail-on never && node scanner/bin.mjs scan fixtures/bad-app --format html --out fixtures/scans/bad-app.report.html --fail-on never && node scanner/bin.mjs scan fixtures/clean-app --format json --out fixtures/scans/clean-app.scan.json --fail-on never",
    "serve:demo": "python scripts/serve_demo.py --port 3111 --base-path rescue-scanner"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
